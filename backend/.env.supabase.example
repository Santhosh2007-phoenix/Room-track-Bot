# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Prefer the Session Pooler connection string if your hosting platform cannot use direct IPv6.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
PGSSL=true
PG_POOL_MAX=5
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-demo-password
API_KEY=replace-with-a-random-device-key-at-least-24-characters

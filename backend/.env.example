# ==============================================================================
# ROOM TRACK BOT — Backend Environment Configuration
# Project: https://eepqkyjzfnzjqjwnshxf.supabase.co
# ==============================================================================

# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Format (Session Pooler):
# postgresql://postgres.eepqkyjzfnzjqjwnshxf:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.eepqkyjzfnzjqjwnshxf:YOUR_DB_PASSWORD_HERE@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Enable SSL for Supabase hosted databases
PGSSL=true
PG_POOL_MAX=5

# Backend Port
PORT=4000

# Allowed Frontend Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT secret key for admin authentication session (at least 32 characters)
JWT_SECRET=super_secret_jwt_room_track_bot_2026_secure_key_at_least_32_chars

# ESP32 Device Secret API Key for hardware communication (at least 24 characters)
API_KEY=esp32-room-track-bot-secret-key-32chars

# Default Admin Account credentials (seeded automatically on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional Supabase REST / Client Credentials (kept secure on backend)
SUPABASE_URL=https://eepqkyjzfnzjqjwnshxf.supabase.co
SUPABASE_ANON_KEY=sb_publishable_yoAAcvvfChQUn2HL5oslYw_bRq6d3HL

# Groq Cloud Whisper STT API Key (free from console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Fast2SMS API Key for normal SMS (free credits from fast2sms.com)
FAST2SMS_API_KEY=

# CallMeBot WhatsApp API (free from callmebot.com)
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_APIKEY=

# Default Demo Attender Phone (used if a patient in DB has no phone number)
DEMO_ATTENDER_PHONE=9876543210
